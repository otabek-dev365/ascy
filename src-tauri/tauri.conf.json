{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ascy",
  "identifier": "uz.otabek.ascy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ascy",
        "width": 950,
        "height": 620,
        "minWidth": 400,
        "minHeight": 300,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "A hacker-style terminal emulator",
    "longDescription": "Ascy is a terminal emulator built with Tauri and xterm.js: tabs, split panes, scrollback search, two themes and an optional Matrix rain background.",
    "copyright": "Copyright (c) 2026 Otabek",
    "linux": {
      "deb": {
        "section": "x11",
        "desktopTemplate": "ascy.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
